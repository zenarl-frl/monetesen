# Copy to backend/.env. The default workspace uses reproducible demo providers.
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATA_FILE=./data/workspace.json
COOKIE_SECURE=false
# Set a long password before enabling any external provider / Telegram.
APP_PASSWORD=
SESSION_SECRET=
MARKET_PROVIDER=demo
MARKET_API_URL=
MARKET_API_TOKEN=
CALENDAR_PROVIDER=demo
CALENDAR_API_URL=
CALENDAR_API_TOKEN=
BROKER_PROVIDER=demo
BROKER_BRIDGE_URL=
BROKER_BRIDGE_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAX_RISK_PERCENT=5
MAX_MARGIN_PERCENT=50
