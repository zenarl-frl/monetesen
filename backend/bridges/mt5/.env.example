MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8787
MT5_BRIDGE_TOKEN=replace-with-a-long-random-token
# Optional: the running terminal account is used when these are blank.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Broker symbol suffix mapping, e.g. XAUUSDm / EURUSD.a
MT5_SYMBOLS={"XAU/USD":"XAUUSD","EUR/USD":"EURUSD","BTC/USD":"BTCUSD","BBCA.JK":"BBCA"}
MT5_HISTORY_DAYS=90
